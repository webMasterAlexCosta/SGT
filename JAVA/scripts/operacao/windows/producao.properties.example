# Exemplo publico incompleto, sem credenciais; nao executar como configuracao pronta.
# Copiar para pasta privada NTFS e preencher pelo responsavel. Caminhos Windows usam /.
# Defaults nao secretos mantem a configuracao de referencia ensaiada; limites precisam de aceite operacional.
# JWT_SECRET: pelo menos64 caracteres; AUDIT_SECRET: pelo menos32, distinto de JWT.
# REDIS_PASSWORD: exclusiva da instancia; nao usar valor publico de desenvolvimento.
APPUSER_RETROACTIVE_UNLOCK_DAYS=7
APPUSER_RETROACTIVE_UNLOCK_HOURS=24
APP_NAME=sig-gtrat-backend
APP_SEED_EXECUTAR_APENAS_UMA_VEZ=true
APP_SEED_GESTORES_INITIAL_PASSWORD=
APP_SEED_GESTORES_SE_GESTAO_LOCAL_ENABLED=false
APP_SEED_JORNADAS_OPERACIONAIS_ENABLED=false
APP_SEED_UNIDADES_OPERACIONAIS_ENABLED=false
APP_SEED_USUARIOS_GLOBAIS_ENABLED=false
APP_SEED_USUARIOS_GLOBAIS_INITIAL_PASSWORD=
AUDITLOG_FLUSH_BATCH_SIZE=500
AUDITLOG_FLUSH_DELAY_MS=500
AUDITLOG_FLUSH_RETRY_ATTEMPTS=3
AUDITLOG_FLUSH_RETRY_DELAY_MS=2000
AUDITLOG_QUEUE_CAPACITY=20000
AUDIT_FALLBACK_LOG=C:/SGT/dados/auditoria/fallback.jsonl
AUDIT_PAYLOAD_MAX_BYTES=65536
AUDIT_SECRET=
AUDIT_SENSITIVE_FIELDS_REGEX=(?i)^(password|senha|pass|token|authorization|secret|refreshToken|accessToken|jwt|chave|pix|apiKey|clientSecret)$
AUTH_DEVICE_COOKIE_MAX_AGE_SECONDS=7200
AUTH_GENERIC_ERROR=Credenciais inválidas.
AUTH_PASSWORD_MIN_LENGTH=8
CACHE_TYPE=redis
CORS_ALLOWED_ORIGINS=https://sgt.example.invalid:8443
DB_CONN_TIMEOUT_MS=30000
DB_DRIVER=org.postgresql.Driver
DB_MAX_POOL_SIZE=8
DB_MIN_IDLE=1
DB_PASS=
DB_POOL_NAME=SGT-Hikari
DB_URL=jdbc:postgresql://127.0.0.1:5432/sgt_prod
DB_USER=sgt_app
EMPREGADO_MAX_JORNADA_MINUTES=480
FILE_UPLOAD_DIR=C:/SGT/dados/uploads
FORWARD_HEADERS_STRATEGY=none
FREQUENCIA_FECHAMENTO_CHUNK_SIZE=500
FREQUENCIA_FECHAMENTO_EXECUTOR_CORE=1
FREQUENCIA_FECHAMENTO_EXECUTOR_MAX=1
FREQUENCIA_FECHAMENTO_EXECUTOR_QUEUE=100
FREQUENCIA_FECHAMENTO_MAX_ALTERACOES=25000
FREQUENCIA_FECHAMENTO_RECOVERY_DELAY_MS=30000
FREQUENCIA_FECHAMENTO_STALE_AFTER_SECONDS=300
FREQUENCIA_JANELA_OPERACIONAL_DIAS=7
FREQUENCIA_EDICAO_HORAS=72
FREQUENCIA_MAX_BATCH_SIZE=1000
FREQUENCIA_MAX_RANGE_DAYS=45
GMAIL_EMAIL_ENABLED=false
GMAIL_EMAIL_FROM=
GMAIL_EMAIL_FROM_NAME=SIG GTRAT - Correios
GMAIL_EMAIL_LOGO_CLASSPATH=email/correios.png
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_AUTH=true
GMAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_READ_TIMEOUT_MS=10000
GMAIL_SMTP_STARTTLS_ENABLE=true
GMAIL_SMTP_STARTTLS_REQUIRED=true
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_WRITE_TIMEOUT_MS=10000
JACKSON_DATE_FORMAT=yyyy-MM-dd'T'HH:mm:ss.SSSXXX
JACKSON_FAIL_ON_EMPTY_BEANS=false
JPA_BATCH_SIZE=100
JPA_DEFAULT_BATCH_FETCH_SIZE=100
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_FORMAT_SQL=false
JPA_OPEN_IN_VIEW=false
JPA_SHOW_SQL=false
JWT_CACHE_CLEANUP_MS=300000
JWT_CACHE_TTL_MS=30000
JWT_CLEANUP_BATCH_SIZE=1000
JWT_CLEANUP_CRON=0 0 * * * ?
JWT_CLEANUP_RETRY_ATTEMPTS=3
JWT_CLEANUP_RETRY_DELAY_MS=3000
JWT_EXPIRATION=7200
JWT_MAX_INACTIVITY_MINUTES=30
JWT_SECRET=
JWT_UPDATE_INTERVAL_SECONDS=300
LOGIN_ATTEMPT_CLEANUP_RATE_MS=60000
LOGIN_BLOCK_DURATION_MS=30000
LOGIN_MAX_ATTEMPTS=5
LOG_APPLICATION=INFO
LOG_HIBERNATE_BIND=OFF
LOG_SPRING_SECURITY=WARN
LOG_SPRING_WEB=WARN
OCORRENCIA_MAX_PERIOD_DAYS=120
PAINEL_CACHE_MINUTOS=10
PAINEL_RECUPERACAO_INTERVALO_MS=30000
PAINEL_TIMEOUT_MINUTOS=30
PASSWORD_RESET_CLEANUP_CRON=0 30 3 * * ?
PASSWORD_RESET_FRONTEND_URL=https://sgt.example.invalid:8443
PASSWORD_RESET_MIN_REQUEST_INTERVAL_SECONDS=60
PASSWORD_RESET_TOKEN_MINUTES=20
RATELIMIT_CLEANUP_RATE_MS=3600000
RATELIMIT_TIMEOUT_MS=10000
RATE_LIMIT_CAPACITY=1000000
RATE_LIMIT_DURATION_SECONDS=10
REDIS_CACHE_LOG_LEVEL=INFO
REDIS_COMMAND_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_HTTP_GET_ENABLED=true
REDIS_HTTP_GET_MAX_RESPONSE_BYTES=2097152
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_TTL_EMPREGADOS_FREQUENCIA=5m
REDIS_TTL_EMPREGADOS_RESUMO=90s
REDIS_TTL_FREQUENCIAS=2m
REDIS_TTL_HTTP_GET=45s
REDIS_TTL_PAINEL=15m
RELATORIO_EXPORTACAO_TIMEOUT_MS=14400000
RELATORIO_TEMP_CLEANUP_INITIAL_DELAY_MS=300000
RELATORIO_TEMP_CLEANUP_MS=1800000
RELATORIO_TEMP_DIR=C:/SGT/temporarios/relatorios
RELATORIO_TEMP_TTL_MS=28800000
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8443
SISTEMA_MANUTENCAO=false
SISTEMA_PREVISAO_RETORNO=
SSL_ENABLED=true
SSL_KEY_ALIAS=sgt
SSL_KEY_STORE=file:///C:/SGT/privado/servidor.p12
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12
TIMEZONE_PADRAO=America/Sao_Paulo
TOTP_PERIOD_SECONDS=30
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=26214400

# Preenchidos apenas para o comissionamento explicito; nao sao seeds do servico.
sgt.admin.username=
sgt.admin.matricula=
sgt.admin.email=
sgt.admin.password=
# Redis remoto deve ter endpoint/TLS/trust definidos pelo responsavel.
spring.data.redis.ssl.enabled=false
