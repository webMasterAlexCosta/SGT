<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>sig-gtrat-backend</artifactId>
    <version>0.0.4-operacional-20261101</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Metadados ZIP estáveis para reproduzir os bytes desta versão derivada. -->
        <project.build.outputTimestamp>2026-11-02T00:00:00Z</project.build.outputTimestamp>

        <!-- Versões presentes no repositório Maven offline validado. -->
        <mysql.version>9.7.0</mysql.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <lombok.version>1.18.46</lombok.version>
        <byte-buddy.version>1.17.8</byte-buddy.version>
        <!-- Correções verificadas nas faixas oficiais OSV; mantêm as linhas
             compatíveis com Spring Boot3.5 e Java17. Evidências em docs. -->
        <tomcat.version>10.1.59</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <log4j2.version>2.25.5</log4j2.version>


        <jjwt.version>0.13.0</jjwt.version>
        <archunit.version>1.4.2</archunit.version>
        <asm.version>9.7.1</asm.version>
        <googleauth.version>1.5.0</googleauth.version>
        <zxing.version>3.5.4</zxing.version>
        <openpdf.version>1.3.30</openpdf.version>
        <bucket4j.version>8.10.1</bucket4j.version>

        <!-- Ferramentas de engenharia de testes/qualidade. -->
        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.25.7</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>

        <!-- Testes de integração MySQL são opt-in para manter `mvn test` rápido. -->
        <skipITs>true</skipITs>
        <!-- Orçamento conservador: Maven 512 MiB + um fork de testes 768 MiB. -->
        <test.jvm.args>-Xmx768m -XX:MaxMetaspaceSize=256m</test.jvm.args>
        <failsafe.groups></failsafe.groups>
        <failsafe.excludedGroups>load</failsafe.excludedGroups>
    </properties>

    <dependencies>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envio de e-mail transacional (Gmail SMTP / Jakarta Mail) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Banco de dados -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Suporte Jackson 2 para LocalDate, LocalDateTime e demais tipos java.time. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- Autenticação em dois fatores -->
        <dependency>
            <groupId>com.warrenstrange</groupId>
            <artifactId>googleauth</artifactId>
            <version>${googleauth.version}</version>

            <exclusions>
                <exclusion>
                    <groupId>org.apache.httpcomponents</groupId>
                    <artifactId>httpclient</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- QR Code local para inscrição TOTP; nenhum segredo é enviado a serviços externos. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Redis usado exclusivamente como cache distribuído. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- AOP compatível com Spring Boot 3.x. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Retry é gerenciado pela linha Spring Boot 3.5. -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- PDF -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- Testcontainers 1.x gerenciado pelo Spring Boot 3.5. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ASM utilizado nos testes -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testes de arquitetura -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testes Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>

            <exclusions>
                <exclusion>
                    <groupId>org.ow2.asm</groupId>
                    <artifactId>asm</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            O Mockito Inline precisa da instrumentação antes de iniciar a JVM de
            testes. Declarar o agente explicitamente mantém `mvn test` reproduzível
            em Java 17, inclusive em ambientes que bloqueiam auto-attach.
        -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${byte-buddy.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Ativa explicitamente o Lombok como processador de anotações.
                Mantém o processamento de anotações explícito e reproduzível na build com Java 17.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Cobertura estrutural real dos testes. O agente JaCoCo é anexado ao
                Surefire e o relatório HTML/XML/CSV é produzido ao final de `mvn test`
                em target/site/jacoco/. Não há threshold obrigatório aqui para não
                introduzir uma quebra artificial antes de medir a linha de base.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Executa toda a suíte JUnit 5 com `mvn test`. O listener registrado
                em src/test/resources gera target/relatorios/relatorio-testes-java.pdf.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <failIfNoTests>true</failIfNoTests>
                    <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>@{argLine} ${test.jvm.args} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar</argLine>
                    <systemPropertyVariables>
                        <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                        <spring.test.context.cache.maxSize>2</spring.test.context.cache.maxSize>
                        <user.timezone>America/Sao_Paulo</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Suíte pesada contra MySQL real/Testcontainers.
                *IT não entra no `mvn test`; use -Pintegration ou -Pdb-load.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <skipITs>${skipITs}</skipITs>
                    <groups>${failsafe.groups}</groups>
                    <excludedGroups>${failsafe.excludedGroups}</excludedGroups>
                    <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>@{argLine} ${test.jvm.args} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar</argLine>
                    <systemPropertyVariables>
                        <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                        <spring.test.context.cache.maxSize>2</spring.test.context.cache.maxSize>
                        <user.timezone>America/Sao_Paulo</user.timezone>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
            Integração completa de persistência: schema Hibernate, repositories,
            constraints, concorrência, rollback e disponibilidade. Exclui carga longa.
        -->
        <profile>
            <id>integration</id>
            <properties>
                <skipITs>false</skipITs>
                <failsafe.groups></failsafe.groups>
                <failsafe.excludedGroups>load</failsafe.excludedGroups>
            </properties>
        </profile>

        <!-- Executa apenas os cenários marcados como @Tag("load"). -->
        <profile>
            <id>db-load</id>
            <properties>
                <skipITs>false</skipITs>
                <failsafe.groups>load</failsafe.groups>
                <failsafe.excludedGroups></failsafe.excludedGroups>
            </properties>
        </profile>

        <!--
            Mutation testing é deliberadamente opt-in por ser computacionalmente caro.
            Mede se os testes detectam defeitos introduzidos automaticamente, em vez
            de apenas verificar se linhas foram executadas.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.example.siggtrat.*</param>
                            </targetClasses>
                            <excludedTestClasses>
                                <param>com.example.siggtrat.integration.*</param>
                                <param>com.example.siggtrat.load.*</param>
                                <param>com.example.siggtrat.report.*</param>
                                <param>com.example.siggtrat.*ArchitectureTest</param>
                                <param>com.example.siggtrat.*ValidationTest</param>
                                <param>com.example.siggtrat.ChaosFuzzingTest</param>
                                <param>com.example.siggtrat.ConcurrencyStressTest</param>
                                <param>com.example.siggtrat.SecurityPenetrationTest</param>
                            </excludedTestClasses>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <withHistory>true</withHistory>
                            <threads>2</threads>
                            <jvmArgs><param>-Xmx512m</param><param>-XX:MaxMetaspaceSize=256m</param></jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
