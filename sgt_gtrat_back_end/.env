# Copie este arquivo para .env e ajuste os valores do seu ambiente.
APP_NAME=sig-gtrat-backend

DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://127.0.0.1:3306/sgt_homologacao?useUnicode=true&characterEncoding=UTF-8&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=root
DB_PASS=445578@@
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=2
DB_CONN_TIMEOUT_MS=30000
DB_POOL_NAME=siggtratHikariPool

# Em uma base nova e vazia, cria o schema canônico; nas reinicializações, preserva os dados.
JPA_DDL_AUTO=update
JPA_OPEN_IN_VIEW=true
JPA_DIALECT=org.hibernate.dialect.MySQLDialect
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
JPA_BATCH_SIZE=100
JPA_DEFAULT_BATCH_FETCH_SIZE=100
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=5000
SSL_ENABLED=false
SSL_KEY_STORE=classpath:certificados/keystore.p12
SSL_KEY_STORE_PASSWORD=Iiurd45!!67@@
SSL_KEY_STORE_TYPE=PKCS12
SSL_KEY_ALIAS=SGT
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Segredo fictício exclusivo deste ensaio local. Troque antes de homologar.
JWT_SECRET=sgt-local-2026-jwt-secret-ficticio-64-bytes-rotacionar-antes-de-homologar-001
JWT_EXPIRATION=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MS=30000
LOGIN_ATTEMPT_CLEANUP_RATE_MS=60000
JWT_MAX_INACTIVITY_MINUTES=30
JWT_UPDATE_INTERVAL_SECONDS=300
JWT_CACHE_TTL_MS=30000
JWT_CACHE_CLEANUP_MS=300000
JWT_CLEANUP_CRON=0 0 * * * ?
JWT_CLEANUP_BATCH_SIZE=1000
JWT_CLEANUP_RETRY_ATTEMPTS=3
JWT_CLEANUP_RETRY_DELAY_MS=3000
TOTP_PERIOD_SECONDS=30

RATE_LIMIT_CAPACITY=10000
RATE_LIMIT_DURATION_SECONDS=10
RATELIMIT_CLEANUP_RATE_MS=3600000
RATELIMIT_TIMEOUT_MS=3600000

FILE_UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=26214400
UPLOAD_MAX_FILES=5

FREQUENCIA_MAX_RANGE_DAYS=45
FREQUENCIA_MAX_BATCH_SIZE=1000
OCORRENCIA_MAX_PERIOD_DAYS=120

AUTH_PASSWORD_MIN_LENGTH=8
AUTH_DEVICE_COOKIE_MAX_AGE_SECONDS=7200
AUTH_GENERIC_ERROR=Credenciais inv\u00e1lidas.
APPUSER_RETROACTIVE_UNLOCK_HOURS=24
APPUSER_RETROACTIVE_UNLOCK_DAYS=7
EMPREGADO_MAX_JORNADA_MINUTES=480

AUDIT_SECRET=sgt-local-2026-audit-secret-ficticio-rotacionar-antes-de-homologar
AUDIT_FALLBACK_LOG=${java.io.tmpdir}/audit_fallback.log
AUDIT_PAYLOAD_MAX_BYTES=65536
AUDIT_SENSITIVE_FIELDS_REGEX=(?i)^(password|newPassword|currentPassword|senha|pass|token|authorization|secret|refreshToken|accessToken|jwt|chave|pix|apiKey|clientSecret)$
AUDITLOG_QUEUE_CAPACITY=20000
AUDITLOG_FLUSH_BATCH_SIZE=500
AUDITLOG_FLUSH_DELAY_MS=500
AUDITLOG_FLUSH_RETRY_ATTEMPTS=3
AUDITLOG_FLUSH_RETRY_DELAY_MS=2000

# Habilite apenas em homologação controlada. Em produção, mantenha false.
APP_SEED_EXECUTAR_APENAS_UMA_VEZ=true
APP_SEED_HOMOLOGACAO_ENABLED=true
APP_SEED_UNIDADES_OPERACIONAIS_ENABLED=true
APP_SEED_JORNADAS_OPERACIONAIS_ENABLED=true
APP_SEED_USUARIOS_GLOBAIS_ENABLED=true
APP_SEED_USUARIOS_GLOBAIS_INITIAL_PASSWORD=123456
# Usuários globais: adm, gestorNacional e presidente.
# Usuários estruturais por UF: gestor_se_uf e gestor_gtrat_uf.
# Troque a senha abaixo antes de iniciar o sistema em produção.
APP_SEED_GESTORES_SE_GESTAO_LOCAL_ENABLED=true
APP_SEED_GESTORES_INITIAL_PASSWORD=123456
# Carga fictícia baseada apenas na estrutura das planilhas (sem nomes/CPFs originais).
APP_SEED_TERCEIRIZADOS_ENABLED=true
APP_SEED_TERCEIRIZADOS_BATCH_SIZE=1000
APP_SEED_TERCEIRIZADOS_MULTIPLIER=1
APP_SEED_TERCEIRIZADOS_SP_PERCENT=15
APP_SEED_TERCEIRIZADOS_RJ_PERCENT=70
SISTEMA_MANUTENCAO=false
SISTEMA_PREVISAO_RETORNO=
JACKSON_FAIL_ON_EMPTY_BEANS=false
TIMEZONE_PADRAO=America/Sao_Paulo
JACKSON_DATE_FORMAT=yyyy-MM-dd
LOG_HIBERNATE_BIND=INFO
LOG_APPLICATION=INFO
LOG_SPRING_SECURITY=INFO
LOG_SPRING_WEB=INFO


# FECHAMENTO ASSÍNCRONO DE FREQUÊNCIA (SEM REDIS)
FREQUENCIA_FECHAMENTO_CHUNK_SIZE=500
FREQUENCIA_FECHAMENTO_MAX_ALTERACOES=25000
FREQUENCIA_FECHAMENTO_EXECUTOR_CORE=1
FREQUENCIA_FECHAMENTO_EXECUTOR_MAX=1
FREQUENCIA_FECHAMENTO_EXECUTOR_QUEUE=100
FREQUENCIA_FECHAMENTO_RECOVERY_DELAY_MS=30000
FREQUENCIA_FECHAMENTO_STALE_AFTER_SECONDS=300

# REDIS - usado apenas como cache. Suba com:
# docker compose -f docker-compose.redis.yml up -d
# Painel gerencial assíncrono
PAINEL_CACHE_MINUTOS=10
PAINEL_TIMEOUT_MINUTOS=30
PAINEL_RECUPERACAO_INTERVALO_MS=30000

CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sgt-local-redis-ficticio
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms
REDIS_TTL_PAINEL=15m
REDIS_TTL_EMPREGADOS_RESUMO=90s
REDIS_TTL_EMPREGADOS_FREQUENCIA=5m
REDIS_TTL_FREQUENCIAS=2m
REDIS_CACHE_LOG_LEVEL=DEBUG
REDIS_MAXMEMORY=512mb

# Cache Redis para respostas GET JSON autenticadas
REDIS_TTL_HTTP_GET=45s
REDIS_HTTP_GET_ENABLED=false
REDIS_HTTP_GET_MAX_RESPONSE_BYTES=2097152

# RECUPERAÇÃO DE SENHA POR GMAIL SMTP
# Ative a verificação em duas etapas na conta Google e gere uma senha de app.
# Use a senha de app em GMAIL_SMTP_APP_PASSWORD; não use a senha normal da conta.
GMAIL_EMAIL_ENABLED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=alevivaldibr2@gmail.com
GMAIL_SMTP_APP_PASSWORD=rjxm jjgv htmo flda
GMAIL_EMAIL_FROM=alevivaldibr2@gmail.com
GMAIL_EMAIL_FROM_NAME=SIG GTRAT - Correios
GMAIL_EMAIL_LOGO_CLASSPATH=email/correios.png
GMAIL_SMTP_AUTH=true
GMAIL_SMTP_STARTTLS_ENABLE=true
GMAIL_SMTP_STARTTLS_REQUIRED=true
GMAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
GMAIL_SMTP_READ_TIMEOUT_MS=10000
GMAIL_SMTP_WRITE_TIMEOUT_MS=10000
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=20
PASSWORD_RESET_MIN_REQUEST_INTERVAL_SECONDS=60
PASSWORD_RESET_CLEANUP_CRON=0 30 3 * * ?

# Timeout máximo para montar o temporário e transferir XLSX/PDF nacionais (4 horas).
RELATORIO_EXPORTACAO_TIMEOUT_MS=14400000

# Relatórios nacionais grandes: pasta temporária no disco do servidor.
# Vazio = java.io.tmpdir/sgt/relatorios
RELATORIO_TEMP_DIR=
RELATORIO_TEMP_TTL_MS=28800000
RELATORIO_TEMP_CLEANUP_MS=1800000
RELATORIO_TEMP_CLEANUP_INITIAL_DELAY_MS=300000
FORWARD_HEADERS_STRATEGY=framework
