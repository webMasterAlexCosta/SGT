# Scripts POSIX devem permanecer LF para execução em Linux/containers.
mvnw text eol=lf
*.sh text eol=lf

# Scripts Windows permanecem CRLF.
mvnw.cmd text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Código e configurações textuais normalizados.
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
